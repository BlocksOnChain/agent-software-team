# PostgreSQL (PostgresQL) Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=templatel7
POSTGRES_PORT=5432

# Application
APP_PORT=3000
NODE_ENV=production

# Prisma Database URL (generated from above values, used by Docker Compose)
DATABASE_URL="postgresql://postgres:your-secure-password@db:5432/templatel7?schema=public"

# AI / API Keys
OPENAI_API_KEY="your-openai-api-key"
TAVILY_API_KEY="your-tavily-api-key"

# Local Development Overrides (uncomment for local development)
# USE_LOCAL_MODEL=true
# QWEN_MODEL_URL="http://localhost:1234/v1"
# QWEN_MODEL_NAME="qwen/qwen3.5-9b"
