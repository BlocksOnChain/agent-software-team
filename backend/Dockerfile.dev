# Development Dockerfile for local Prisma migrations and development
FROM oven/bun:1-alpine AS dev

WORKDIR /app

# Copy dependencies first for caching
COPY package.json bun.lock* ./
RUN bun install --frozen-lockfile

# Copy application files
COPY . .

# Install pgAdmin or another database tool if needed
RUN apk add --no-cache psql postgresql-client

# Expose port
EXPOSE 3000

# Default to production entrypoint, but can be overridden
CMD ["bun", "run", "dev"]
